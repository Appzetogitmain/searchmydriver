# ==============================================================================
# SearchMyDriver - Frontend Environment Template
# ==============================================================================

# ---- Backend API & WebSockets ----
VITE_API_URL=http://localhost:9000/api/v1
VITE_SOCKET_URL=http://localhost:9000

# ---- Google Authentication ----
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ---- Google Maps API ----
# Enable Maps JavaScript API, Places API, and Geocoding API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional: Cloud Console → Map Management. Defaults to DEMO_MAP_ID for dev.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# ---- Razorpay Payment Gateway ----
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# ---- Firebase Realtime Database & Cloud Messaging (live driver locations) ----
# Copy these directly from: Firebase console → Project settings → General → Your apps → Web → SDK config.
# DATABASE_URL must point to a Realtime Database (NOT Firestore).
#
# ⚠️  Every value below must come from the SAME Firebase project, and that
#     project must be the one the backend's service account belongs to
#     (backend FIREBASE_SERVICE_ACCOUNT_JSON → project_id). Mixing projects
#     fails silently in two ways that look like unrelated bugs:
#       • the app subscribes to a different RTDB than the backend writes to,
#         so no driver ever appears on the customer's map; and
#       • every push fails with `messaging/mismatched-credential`, because a
#         token issued by project A cannot be sent to by project B.
#     MESSAGING_SENDER_ID is the project number and must equal the middle
#     segment of APP_ID (`1:<sender-id>:web:...`) — an easy cross-check.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
# Public VAPID key (Cloud Messaging tab → Web Push certificates), 87 chars.
# Not optional in practice: without it `getToken()` cannot issue a web push
# token, so no device ever registers and FCM delivers nothing.
VITE_FIREBASE_VAPID_KEY=